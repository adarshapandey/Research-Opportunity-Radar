{
  "name": "ai-research-opportunity-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "check": "node scripts/check.mjs",
    "discover": "node scripts/discover.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "build": "node scripts/build-site.mjs",
    "preview": "python3 -m http.server 4173 --directory site",
    "model:setup": "python3 scripts/local_runtime.py setup",
    "model:evaluate": "node scripts/evaluate-model.mjs",
    "discover:replay": "DISCOVERY_INPUT=scripts/fixtures/cached-tavily.json node scripts/discover.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
